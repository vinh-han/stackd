{$DOMAIN} {
	# shortcut: one shared login keeps strangers off the Gemini key until real accounts exist.
	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}
	# File uploads (PDF, Word, PowerPoint, images) up to 20 MB; every other request up to 1 MB.
	@upload path /api/extract
	@other not path /api/extract
	request_body @upload {
		max_size 20MB
	}
	request_body @other {
		max_size 1MB
	}
	encode zstd gzip
	reverse_proxy web:3000
}
