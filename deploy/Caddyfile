{$DOMAIN} {
	# shortcut: one shared login keeps strangers off the Gemini key until real accounts exist.
	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}
	# Uploads: documents up to 20 MB, Anki packages (often with media) up to 100 MB, export requests
	# up to 20 MB. Every other request up to 1 MB. The app enforces the exact per-route limits.
	@upload path /api/extract /api/anki/*
	@other not path /api/extract /api/anki/*
	request_body @upload {
		max_size 100MB
	}
	request_body @other {
		max_size 1MB
	}
	encode zstd gzip
	reverse_proxy web:3000
}
