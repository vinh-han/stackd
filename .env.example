# Copy to .env.local and fill in. Read by the Python backend (npm run dev:api, or the `api`
# container). Never exposed to the browser.

# Gemini API key for card generation (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional model override
# GEMINI_MODEL=gemini-3.1-flash-lite

# Supabase (accounts and data). Locally: `npx supabase start`, then copy API_URL and PUBLISHABLE_KEY from
# `npx supabase status`. Both are public: row-level security limits each user to their own rows.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where the Next.js server finds the backend. Compose sets this to http://api:8000.
# BACKEND_URL=http://localhost:8000

# --- Production only: put these in `.env` (next to docker-compose.yaml), not .env.local. ---
# The site has no accounts yet, so Caddy asks for this login. Make the hash with:
#   docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'your-password'
# Keep the single quotes: the hash contains $ signs that Compose would otherwise expand.
# DOMAIN=stackd.example.com
# BASIC_AUTH_USER=you
# BASIC_AUTH_HASH='$2a$14$...'
